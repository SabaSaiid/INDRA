# ==========================================
# INDRA Platform Environment Configuration
# Smart India Hackathon 2026 - Team Sixth Sense
# ==========================================

# Environment Mode: development / production / test
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=indra_super_secret_jwt_key_sih2026

# PostgreSQL + PostGIS Database
POSTGRES_USER=indra_user
POSTGRES_PASSWORD=indra_password
POSTGRES_DB=indra_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://indra_user:indra_password@localhost:5433/indra_db
# The pytest suite uses its own database so it never wipes dev data (created on first run).
TEST_DATABASE_URL=postgresql+asyncpg://indra_user:indra_password@localhost:5433/indra_test

# Redis Cache & WebSocket Pub/Sub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Event Streaming (Kafka / Redpanda)
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_REPORTS_TOPIC=indra.raw.reports
KAFKA_EVENTS_TOPIC=indra.verified.events

# AI & Verification Thresholds
AUTO_PUBLISH_THRESHOLD=0.90
HUMAN_REVIEW_THRESHOLD=0.60
# Geospatial Indexing (PostGIS & Uber H3)
DBSCAN_EPS_KM=5.0
DBSCAN_MIN_SAMPLES=2
H3_HEX_RESOLUTION=8
TIME_WINDOW_MINUTES=120

# Out-of-India coordinates: false rejects with 422 (default); true snaps them
# to a gazetteer match or the national centroid (demo-only, unsafe).
SNAP_OUT_OF_BOUNDS_COORDINATES=false

# Serve hardcoded demo data when a read endpoint finds no rows or the DB is
# down. Always logged at WARNING.
#
# Default false since 20 Sep, and it must stay false for any demo. With it true,
# an EMPTY database answers GET /api/events with invented events carrying
# confidence 0.94 and AUTO_PUBLISHED -- values the real pipeline cannot produce.
# During the first seconds of a live run the database *is* empty, so the dashboard
# would show a confident auto-published CRITICAL event that no code computed.
# An empty dashboard that fills up as reports arrive is both honest and a better
# demonstration.
DEMO_MODE=false

WEATHER_TIMEOUT_SECONDS=3.0

# External Weather API Feeds
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# Station poller -- layer 1's one feed on a schedule (Day 6).
# Every interval, Open-Meteo current precipitation for the six demo cities is
# written to station_readings as agency OPEN_METEO. Off means no task starts and
# the table stays empty; the weather factor then fetches live per event, exactly
# as it did before. Single backend process only -- two would write every reading
# twice, the same rule the Kafka consumer already has.
STATION_POLLER_ENABLED=true
STATION_POLL_INTERVAL_SECONDS=600
# How fresh and how near a stored reading must be for scoring to prefer it over
# a live request. Past either gate, the factor fetches live.
STATION_READING_MAX_AGE_MINUTES=30
STATION_READING_MAX_DISTANCE_KM=25.0
OPENWEATHER_API_KEY=
IMD_API_KEY=
TWITTER_BEARER_TOKEN=

# Storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=indra-evidence-media

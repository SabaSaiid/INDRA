# ==========================================
# INDRA Platform Environment Configuration
# Smart India Hackathon 2026 - Team Sixth Sense
# ==========================================

# Environment Mode: development / production / test
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=indra_super_secret_jwt_key_sih2026

# PostgreSQL + PostGIS Database
POSTGRES_USER=indra_user
POSTGRES_PASSWORD=indra_password
POSTGRES_DB=indra_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://indra_user:indra_password@localhost:5433/indra_db
# The pytest suite uses its own database so it never wipes dev data (created on first run).
TEST_DATABASE_URL=postgresql+asyncpg://indra_user:indra_password@localhost:5433/indra_test

# Redis Cache & WebSocket Pub/Sub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Event Streaming (Kafka / Redpanda)
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_REPORTS_TOPIC=indra.raw.reports
KAFKA_EVENTS_TOPIC=indra.verified.events

# AI & Verification Thresholds
AUTO_PUBLISH_THRESHOLD=0.90
HUMAN_REVIEW_THRESHOLD=0.60
# Geospatial Indexing (PostGIS & Uber H3)
DBSCAN_EPS_KM=5.0
DBSCAN_MIN_SAMPLES=2
H3_HEX_RESOLUTION=8
TIME_WINDOW_MINUTES=120

# Out-of-India coordinates: false rejects with 422 (default); true snaps them
# to a gazetteer match or the national centroid (demo-only, unsafe).
SNAP_OUT_OF_BOUNDS_COORDINATES=false

# Serve hardcoded demo data when a read endpoint finds no rows or the DB is
# down. Always logged at WARNING.
#
# Default false since 20 Sep, and it must stay false for any demo. With it true,
# an EMPTY database answers GET /api/events with invented events carrying
# confidence 0.94 and AUTO_PUBLISHED -- values the real pipeline cannot produce.
# During the first seconds of a live run the database *is* empty, so the dashboard
# would show a confident auto-published CRITICAL event that no code computed.
# An empty dashboard that fills up as reports arrive is both honest and a better
# demonstration.
DEMO_MODE=false

WEATHER_TIMEOUT_SECONDS=3.0

# External Weather API Feeds
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# NOT WIRED. A second weather provider was scoped -- Open-Meteo alone cannot
# corroborate itself -- and no client was ever written. This is not a Settings
# field, so a key put here is discarded at load and nothing changes. Kept as a
# record of the intent; see the block at the end of this file.
# OPENWEATHER_API_KEY=

# SACHET (NDMA) national CAP alert feed -- layer 1's official-warning source.
# No key, no registration. The only public route to IMD and CWC warnings: IMD's
# own API answers 401 "IP needs to be whitelisted" and CWC publishes none.
# The index is ETag-cached, so a tick with no new alerts costs one 304.
SACHET_POLLER_ENABLED=true
SACHET_POLL_INTERVAL_SECONDS=300
# Cold start sees ~99 alerts at once; cap the burst on a disaster agency's feed.
# 10, not 25: at 25 NDMA started answering 403 on the CAP polygon endpoint and
# 96 already-stored footprints were lost. This file said 25 while config.py
# said 10, so anyone following docs/setup.md got the bug back (BUG-038).
SACHET_MAX_FETCHES_PER_TICK=10

# NOT WIRED. NASA FIRMS active-fire detections were scoped and never built; no
# code reads this. The API notes are kept because they were researched and are
# correct, not because anything calls them:
#   GET /api/area/csv/{key}/{SOURCE}/{west,south,east,north}/{days}
#   SOURCE: VIIRS_SNPP_NRT | VIIRS_NOAA20_NRT | MODIS_NRT. days is [1..5], NOT 7.
#   Limit 5000 transactions / 10 min. Free key: firms.modaps.eosdis.nasa.gov/api/map_key/
# FIRMS_MAP_KEY=

# Station poller -- layer 1's one feed on a schedule (Day 6).
# Every interval, Open-Meteo 24 h accumulated precipitation for the six demo
# cities is written to station_readings as agency OPEN_METEO -- the same window
# the score curve reads, so a stored reading substitutes for a live one. Off means no task starts and
# the table stays empty; the weather factor then fetches live per event, exactly
# as it did before. Single backend process only -- two would write every reading
# twice, the same rule the Kafka consumer already has.
STATION_POLLER_ENABLED=true
STATION_POLL_INTERVAL_SECONDS=600
# How fresh and how near a stored reading must be for scoring to prefer it over
# a live request. Past either gate, the factor fetches live.
# 180, not 30: age is measured on the end of the 24 h window, and Open-Meteo
# publishes its hourly buckets about two hours behind (measured 21 Sep: a poll at
# 19:50 UTC returned a series ending 18:00 UTC). At 30 minutes no real reading
# would ever qualify.
STATION_READING_MAX_AGE_MINUTES=180
STATION_READING_MAX_DISTANCE_KM=25.0
# ---------------------------------------------------------------------------
# Declared, but read by nothing. Left here as a record of what was scoped and
# not built, NOT as configuration.
#
# None of the names below is a field on the Settings class, and Settings sets
# extra="ignore", so a value put here is silently discarded at load. Filling
# one in changes nothing and makes the feed look wired when it is not — the
# same class of untruth as a telemetry column that is always 0.0 (BUG-041).
#
#   OPENWEATHER_API_KEY   second weather provider   — no client was written
#   IMD_API_KEY           IMD direct                — IMD answers 401 unless
#                                                     the IP is whitelisted;
#                                                     SACHET is the route used
#   TWITTER_BEARER_TOKEN  social ingest             — never built
#   FIRMS_MAP_KEY         NASA active-fire          — never built
#   S3_*                  evidence media store      — no MinIO service in
#                                                     docker-compose.yml, and
#                                                     nothing uploads
#
# The live weather path is OPEN_METEO_API_URL above, which needs no key.
# ---------------------------------------------------------------------------

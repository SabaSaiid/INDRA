# INDRA Alert Engine - Environment Variables

# ==============================================================================
# Engine Mode
# ==============================================================================
# Set to True to run in DEMO mode (generates mock events internally)
ALERT_ENGINE_MODE=LIVE
ALERT_ENGINE_PORT=8001

# ==============================================================================
# Event Ingestion
# ==============================================================================
# The URL of the main INDRA backend to pull events from
BACKEND_API_URL=http://localhost:8000
# The WebSocket URL of the main INDRA backend for real-time events
BACKEND_WS_URL=ws://localhost:8000/ws/events

# ==============================================================================
# Notification Providers
# ==============================================================================
# Webhook settings
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=

# SMTP Email settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=alerts@indra.local
ALERT_EMAIL_RECIPIENTS=operator@indra.local

# ==============================================================================
# Storage
# ==============================================================================
ALERT_DB_PATH=data/alerts.db

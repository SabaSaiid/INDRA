etry"></mxGeometry></mxCell><mxCell id="data-e8" value="polygon ∩ footprint, or district" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#D79B00;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=5 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.72;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="data-agency_alerts" target="data-verified_events"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1760" y="104" /><mxPoint x="832" y="104" /></Array></mxGeometry></mxCell><mxCell id="data-e9" value="≤ 50 km, in the time window" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#D79B00;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=5 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="data-station_readings" target="data-verified_events"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1505" y="426" /><mxPoint x="1505" y="128" /><mxPoint x="908" y="128" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>

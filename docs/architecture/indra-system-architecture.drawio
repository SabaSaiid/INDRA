olor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dep-h_caddy" target="dep-h_fe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dep-e10" value="asyncpg" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.2112;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dep-h_api" target="dep-dk_pg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dep-e11" value="redis" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.42;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dep-h_api" target="dep-dk_redis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dep-e12" value="aiokafka" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.6289;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dep-h_api" target="dep-dk_rp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dep-e13" value="boto3 · S3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.8746;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dep-h_api" target="dep-dk_s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dep-e14" value="HTTPS polls and per-event reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.0773;entryDx=0;entryDy=0;" edge="1" parent="1" source="dep-h_api" target="dep-z_out"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1255" y="150" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="data" name="4 · Data model"><mxGraphModel background="#FFFFFF" dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="771" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="data-title" value='&lt;b style="font-size:24px"&gt;What is stored, and where&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;PostgreSQL 16 + PostGIS (backend/app/models, Alembic 0001 → 0020), plus Redis, the object store and the Kafka topics. Solid arrow: a foreign key. Dashed arrow: a join made by the code, not by a key.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#222222;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="18" width="2380" height="70" as="geometry" /></mxCell><mxCell id="data-raw_reports" value='&lt;b style="font-size:12px"&gt;raw_reports&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;id uuid PK · docket R-XXXXXXXX&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;created_at · observed_at · processed_at&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;source_type · platform · external_id · source_meta JSONB&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;raw_text · citizen_hazard · hazard_primary · hazard_family&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;latitude, longitude · geom_point POINT · h3_res8&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;district · state · place_precision&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;credibility_score · flags text[] · reporter_hash · submitted_by&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;analysis JSONB: cleaned text, metadata, and analysis.ml from layer 4&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;media_url: a string only; nothing is uploaded&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;event_id → verified_events.id&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;duplicate_of → raw_reports.id&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="400" height="192" as="geometry" /></mxCell><mxCell id="data-outbox" value="&lt;b style=&quot;font-size:12px&quot;&gt;outbox&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;id bigint PK · topic · key&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;payload JSONB: the report's Kafka message&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;created_at · published_at (NULL: still to send) · attempts · last_error&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;partial index on the unpublished rows&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="30" y="392" width="400" height="90" as="geometry" /></mxCell><mxCell id="data-verified_events" value='&lt;b style="font-size:12px"&gt;verified_events&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;id uuid PK · event_code INDRA-YYYYMMDD-NNN&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;event_type · hazard_family · severity&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;confidence_score · verdict · review_status · quadrant&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;center_point POINT · boundary_polygon POLYGON · impact_radius_km&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;district · state · place_precision&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;verification_receipt JSONB: factors, coverage, evidence, contradictions, routing, provenance&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;claimed_by · claimed_at&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;verified_at · updated_at&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="530" y="150" width="420" height="163" as="geometry" /></mxCell><mxCell id="data-teams" value='&lt;b style="font-size:12px"&gt;teams&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;id uuid PK · team_code · name · agency&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;city · state · lead_name · lead_phone · radio_callsign&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;specialization · status · members_count&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;assigned_event_id → verified_events.id (SET NULL)&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="530" y="373" width="420" height="90" as="geometry" /></mxCell><mxCell id="data-user_profiles" value='&lt;b style="font-size:12px"&gt;user_profiles&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;id uuid PK · username · full_name · email · phone&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;role: COMMANDER, ANALYST, ADMIN, CITIZEN, FIELD_RESPONDER&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;agency · operator_id · badge_number · callsign&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;team_id → teams.id (SET NULL) · team_role · duty_status&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;password_hash (bcrypt; no hash, no sign-in) · last_active_at&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="530" y="523" width="420" height="105" as="geometry" /></mxCell><mxCell id="data-event_snapshots" value='&lt;b style="font-size:12px"&gt;event_snapshots&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;id uuid PK · event_id → verified_events.id (CASCADE)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;at · trigger · receipt_version&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;confidence · factor_coverage · report_count&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;verdict · review_status · severity · details JSONB&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1050" y="190" width="400" height="90" as="geometry" /></mxCell><mxCell id="data-audit_logs" value="&lt;b style=&quot;font-size:12px&quot;&gt;audit_logs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;id uuid PK · seq bigint · logged_at&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;event_id → verified_events.id · operator_id&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;action_taken: AUTO_VERIFY, ESCALATE, QUARANTINE, HUMAN_APPROVE, HUMAN_REJECT, MANUAL_OVERRIDE, DATA_EXPORT, LATE_CORROBORATION&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;reason · details JSONB&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;prev_hash · sha256_hash = sha256 of the row's canonical JSON with prev_hash&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;a trigger rejects UPDATE and DELETE; appended under an advisory lock&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1050" y="330" width="400" height="163" as="geometry" /></mxCell><mxCell id="data-agency_alerts" value='&lt;b style="font-size:12px"&gt;agency_alerts&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;id uuid PK · identifier · source_feed · sender&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;msg_type (Alert, Update, Cancel) · status · category · event&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;severity · raw_severity · urgency · certainty&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;sent_at · feed_published_at · effective_at · onset_at · expires_at&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;headline · description · area_desc · district_codes[]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;area_polygon POLYGON · polygon_thinned · polygon_points · fetched_at&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1560" y="190" width="400" height="119" as="geometry" /></mxCell><mxCell id="data-station_readings" value='&lt;b style="font-size:12px"&gt;station_readings&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;id uuid PK · station_code · station_name · feed&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;agency: OPEN_METEO or AERODROME_METAR (IMD, CWC declared, no producer)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;station_location POINT · recorded_at&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;rainfall_mm · temperature_c · dewpoint_c · wind_kmh · gust_kmh&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;visibility_m · weather_codes[] · convective_cloud · raw_observation&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;river_level_m, anomaly_score: no producer&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1560" y="359" width="400" height="134" as="geometry" /></mxCell><mxCell id="data-k_topics" value="&lt;b style=&quot;font-size:12px&quot;&gt;Redpanda topics&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;indra.raw.reports: every stored report, from store_report or the relay&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;consumer groups: indra-report-processor, and the lake archiver's own&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;indra.raw.reports.dlq: a message that failed the pipeline three times&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;indra.verified.events: every created or changed event&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2050" y="150" width="350" height="119" as="geometry" /></mxCell><mxCell id="data-k_redis" value='&lt;b style="font-size:12px"&gt;Redis 7 · services/cache.py&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;wx:&lt;cell&gt;: the Open-Meteo reading per H3 res-8 cell&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;report ids already broadcast as NEW_REPORT&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;failure count per message (the third → DLQ)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;late corroboration: each (trigger, event) pair, 24 h&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;every call falls back to process memory&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2050" y="289" width="350" height="105" as="geometry" /></mxCell><mxCell id="data-k_s3" value='&lt;b style="font-size:12px"&gt;Object store · SeaweedFS, S3 API&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;indra-lake/raw/source=&lt;source&gt;/date=YYYY-MM-DD/hour=HH/&lt;fetched_at&gt;-&lt;uuid&gt;.&lt;ext&gt;.gz&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;reports: JSON Lines · metar: CSV · mastodon: JSON, authors hashed · google_news, sachet: XML&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;indra-media: reserved for report media&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;never on the critical path: a failed write is skipped&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2050" y="414" width="350" height="105" as="geometry" /></mxCell><mxCell
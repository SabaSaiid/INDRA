<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="sys" name="1 · End-to-end system"><mxGraphModel background="#FFFFFF" dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3180" pageHeight="1461" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="sys-c2" value="&lt;b&gt;2 · Data ingestion&lt;/b&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#F3F7FD;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=15;fontColor=#222222;strokeWidth=1.5;container=0;" vertex="1" parent="1"><mxGeometry x="350" y="185" width="650" height="950" as="geometry" /></mxCell><mxCell id="sys-c5" value="&lt;b&gt;6 · Event fusion&lt;/b&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=15;fontColor=#222222;strokeWidth=1.5;container=0;" vertex="1" parent="1"><mxGeometry x="1700" y="185" width="360" height="950" as="geometry" /></mxCell><mxCell id="sys-c6" value="&lt;b&gt;7 · Data platform&lt;/b&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFBEF;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=15;fontColor=#222222;strokeWidth=1.5;container=0;" vertex="1" parent="1"><mxGeometry x="2090" y="185" width="340" height="950" as="geometry" /></mxCell><mxCell id="sys-c7" value="&lt;b&gt;8a · Real-time API&lt;/b&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#F5F6FD;strokeColor=#3F51B5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=15;fontColor=#222222;strokeWidth=1.5;container=0;" vertex="1" parent="1"><mxGeometry x="2460" y="185" width="340" height="950" as="geometry" /></mxCell><mxCell id="sys-c8" value="&lt;b&gt;Consumers&lt;/b&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#FDF3F3;strokeColor=#B85450;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=15;fontColor=#222222;strokeWidth=1.5;container=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="2830" y="185" width="330" height="950" as="geometry" /></mxCell><mxCell id="sys-legend" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#222222;strokeWidth=1.5;container=0;" vertex="1" parent="1"><mxGeometry x="1480" y="1245" width="1680" height="186" as="geometry" /></mxCell><mxCell id="sys-c3" value="&lt;b&gt;3 · Data processing&lt;/b&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#F3F9F2;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=15;fontColor=#222222;strokeWidth=1.5;container=0;" vertex="1" parent="1"><mxGeometry x="1030" y="185" width="310" height="950" as="geometry" /></mxCell><mxCell id="sys-c1" value="&lt;b&gt;1 · Data sources&lt;/b&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#FBFBFB;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=15;fontColor=#222222;strokeWidth=1.5;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="185" width="300" height="950" as="geometry" /></mxCell><mxCell id="sys-c4" value="&lt;b&gt;5 · Geo-analytics&lt;/b&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#F1FAF9;strokeColor=#2A8C82;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=15;fontColor=#222222;strokeWidth=1.5;container=0;" vertex="1" parent="1"><mxGeometry x="1370" y="185" width="300" height="950" as="geometry" /></mxCell><mxCell id="sys-d_pg" value='&lt;b&gt;PostgreSQL 16 + PostGIS 3.4 · :5433&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;font-weight:normal"&gt;20 Alembic migrations, GIST indexes&lt;/span&gt;' style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFBEF;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=12;fontColor=#222222;strokeWidth=1.5;container=0;" vertex="1" parent="1"><mxGeometry x="2105" y="234" width="310" height="640" as="geometry" /></mxCell><mxCell id="sys-p_intake" value="&lt;b&gt;At intake · called by store_report()&lt;/b&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#F3F9F2;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=12;fontColor=#222222;strokeWidth=1.5;container=0;" vertex="1" parent="1"><mxGeometry x="1045" y="234" width="280" height="384" as="geometry" /></mxCell><mxCell id="sys-p_ml" value="&lt;b&gt;4 · AI/ML · frozen, advisory&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;another team member's layer&lt;/span&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#F8F4FA;strokeColor=#9673A6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=12;fontColor=#222222;strokeWidth=1.5;container=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="1045" y="894" width="280" height="221" as="geometry" /></mxCell><mxCell id="sys-p_pipe" value="&lt;b&gt;In the pipeline&lt;/b&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#F3F9F2;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=12;fontColor=#222222;strokeWidth=1.5;container=0;" vertex="1" parent="1"><mxGeometry x="1045" y="634" width="280" height="221" as="geometry" /></mxCell><mxCell id="sys-title" value="&lt;b style=&quot;font-size:26px&quot;&gt;INDRA — end-to-end system&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Intelligent National Disaster &amp;amp; Weather Platform · SIH26069 · Team Sixth Sense. Code as on &lt;i&gt;main&lt;/i&gt; after Phase 4 (PR #47), 28 Sep 2026. A report or a feed item travels left to right; each column is one layer of the team's 9-layer architecture. Pages 2–4: report lifecycle, deployment, data model.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#222222;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="18" width="2000" height="80" as="geometry" /></mxCell><mxCell id="sys-s_cit" value='&lt;b style="font-size:12px"&gt;Citizens&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Report Incident form on the dashboard&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;anonymous · a docket R-XXXXXXXX to follow the report&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="35" y="234" width="270" height="75" as="geometry" /></mxCell><mxCell id="sys-s_cmd" value='&lt;b style="font-size:12px"&gt;Commanders and admins&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;official field reports, signed in with a JWT&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="35" y="323" width="270" height="46" as="geometry" /></mxCell><mxCell id="sys-s_sachet" value='&lt;b style="font-size:12px"&gt;NDMA SACHET · CAP 1.2&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;official IMD, CWC and state SDMA warnings, with area polygons&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="35" y="398" width="270" height="61" as="geometry" /></mxCell><mxCell id="sys-s_om" value='&lt;b style="font-size:12px"&gt;Open-Meteo&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;forecast and air-quality APIs: rain, temperature, wind, visibility…&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="35" y="472" width="270" height="61" as="geometry" /></mxCell><mxCell id="sys-s_metar" value='&lt;b style="font-size:12px"&gt;aviationweather.gov&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;METAR from Indian aerodromes&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="35" y="547" width="270" height="46" as="geometry" /></mxCell><mxCell id="sys-s_masto" value='&lt;b style="font-size:12px"&gt;Mastodon&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;#IMD and weather-hashtag posts&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="35" y="607" width="270" height="46" as="geometry" /></mxCell><mxCell id="sys-s_news" value='&lt;b style="font-size:12px"&gt;Google News RSS&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;weather headlines, English and Hindi&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="35" y="668" width="270" height="46" as="geometry" /></mxCell><mxCell id="sys-s_none" value='&lt;b style="font-size:12px"&gt;Not connected&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;IMD AWS and IMD API, CWC gauges, Twitter/X: no credentials&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;images and video: vision is out of scope&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="35" y="742" width="270" height="75" as="geometry" /></mxCell><mxCell id="sys-i_rest" value='&lt;b style="font-size:12px"&gt;REST intake · api/reports.py&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;POST /api/reports/submit → 202 + docket&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;POST /api/reports/official · COMMANDER/ADMIN&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;outside India → 422, never stored&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;swapped lat/lng corrected&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="365" y="234" width="285" height="136" as="geometry" /></mxCell><mxCell id="sys-i_poll" value='&lt;b style="font-size:12px"&gt;Scheduled pollers · asyncio tasks in the API process&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;sachet_poller · every 5 min → agency_alerts&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;station_poller · every 10 min, 6 cities → station_readings&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;metar_poller · every 10 min → station_readings&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;mastodon_poller · every 5 min → reports&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;news_poller · every 15 min → reports&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;each tick: a raw copy to the lake and a heartbeat in /api/meta/sources&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;new warnings and significant METARs trigger late corroboration&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="365" y="398" width="285" height="316" as="geometry" /></mxCell><mxCell id="sys-i_store" value='&lt;b style="font-size:12px"&gt;ingest.store_report()&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;report row + outbox row in one transaction; 503 if it cannot be stored&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;calls layer 3: clean, tag, flag, score credibility&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;publishes at once (2 s budget), else leaves it to the relay&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="680" y="234" width="285" height="105" as="geometry" /></mxCell><mxCell id="sys-i_relay" value='&lt;b style="font-size:12px"&gt;outbox_relay&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;publishes every unpublished outbox row, however long Redpanda was down&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="680" y="353" width="285" height="61" as="geometry" /></mxCell><mxCell id="sys-i_kafka" value='&lt;b style="font-size:12px"&gt;Redpanda · Kafka API&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;indra.raw.reports&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;indra.raw.reports.dlq (after retries)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;indra.verified.events (no subscriber in the repo yet)&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="680" y="447" width="285" height="75" as="geometry" /></mxCell><mxCell id="sys-i_cons" value='&lt;b style="font-size:12px"&gt;report_consumer&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;group indra-report-processor&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;NEW_REPORT / NEW_FEED_ITEM once per report id (Redis)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;runs the pipeline; a failure is retried, then dead-lettered (scripts/replay_dlq.py)&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="680" y="563" width="285" height="105" as="geometry" /></mxCell><mxCell id="sys-i_lake" value='&lt;b style="font-size:12px"&gt;lake_archiver&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;its own consumer group: every message on the report stream to the lake&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;commits the offset only after the write&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="680" y="681" width="285" height="75" as="geometry" /></mxCell><mxCell id="sys-p_text" value='&lt;b style="font-size:12px"&gt;Text cleaning + metadata&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;text_processing.py: cleaned text, language, depth_cm, keywords, places&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;regex and dictionaries; the receipt says rule_based&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1055" y="264" width="260" height="90" as="geometry" /></mxCell><mxCell id="sys-p_haz" value='&lt;b style="font-size:12px"&gt;Hazard tagger&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;hazard_tagger.py → hazard_primary, hazard_family&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1055" y="368" width="260" height="61" as="geometry" /></mxCell><mxCell id="sys-p_flags" value='&lt;b style="font-size:12px"&gt;Flags + credibility&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;report_flags.py: misleading-text flags&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;credibility.py: credibility_score&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1055" y="443" width="260" height="61" as="geometry" /></mxCell><mxCell id="sys-p_geo" value='&lt;b style="font-size:12px"&gt;Geocoding&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;737-district Census 2011 gazetteer, forward and reverse&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;refuses rather than guesses: no name for open sea&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1055" y="518" width="260" height="90" as="geometry" /></mxCell><mxCell id="sys-p_dedup" value='&lt;b style="font-size:12px"&gt;② Dedup&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;frozen local matcher, inside ≤ 1 km and ≤ 15 min gates&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;duplicate_of recorded: a duplicate never counts as corroboration&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1055" y="664" width="260" height="90" as="geometry" /></mxCell><mxCell id="sys-p_coord" value="&lt;b style=&quot;font-size:12px&quot;&gt;②b Coordinated text&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;the same text from ≥ 3 reporters within 10 min: each copy's credibility halved&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1055" y="784" width="260" height="61" as="geometry" /></mxCell><mxCell id="sys-m_eng" value='&lt;b style="font-size:12px"&gt;ml_adapter.py → frozen engine&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;six components: NLP, duplicate, event, credibility, image, anomaly&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;synthetic-development data only · NOT_VALIDATED&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1055" y="940" width="260" height="90" as="geometry" /></mxCell><mxCell id="sys-m_out" value='&lt;b style="font-size:12px"&gt;→ raw_reports.analysis.ml&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;advisory: never a fusion factor, never decides review status&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1055" y="1044" width="260" height="61" as="geometry" /></mxCell><mxCell id="sys-g_prep" value='&lt;b style="font-size:12px"&gt;③ Spatial preparation&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;PostGIS geom_point and an H3 res-8 cell for each report&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D3EEEC;strokeColor=#2A8C82;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1385" y="234" width="270" height="61" as="geometry" /></mxCell><mxCell id="sys-g_db" value="&lt;b style=&quot;font-size:12px&quot;&gt;④ DBSCAN clustering&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;great-circle eps 5 km, at least 2 reports&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;same hazard family, recent reports only&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;a lone report inside a known event's footprint joins that event&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D3EEEC;strokeColor=#2A8C82;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1385" y="321" width="270" height="90" as="geometry" /></mxCell><mxCell id="sys-g_stats" value='&lt;b style="font-size:12px"&gt;⑤ Cluster geometry&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;centroid, impact radius, max pairwise distance, in metres&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D3EEEC;strokeColor=#2A8C82;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1385" y="437" width="270" height="61" as="geometry" /></mxCell><mxCell id="sys-g_poly" value="&lt;b style=&quot;font-size:12px&quot;&gt;Boundary polygon · written at ⑦&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;concave hull of the event's non-duplicate reports, buffered 250 m; convex-hull fallback&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;served as boundary_geojson&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D3EEEC;strokeColor=#2A8C82;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1385" y="558" width="270" height="75" as="geometry" /></mxCell><mxCell id="sys-g_heat" value='&lt;b style="font-size:12px"&gt;Heatmap · read side&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;GET /api/geo/heatmap: H3 res 6/7/8 over 24 h, 48 h or 7 d, duplicates excluded&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D3EEEC;strokeColor=#2A8C82;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1385" y="647" width="270" height="61" as="geometry" /></mxCell><mxCell id="sys-g_risk" value='&lt;b style="font-size:12px"&gt;Risk zones&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;not built&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1385" y="722" width="270" height="46" as="geometry" /></mxCell><mxCell id="sys-f_merge" value='&lt;b style="font-size:12px"&gt;⑤a Merge into a recent event&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;footprint overlap (radius + eps), last 2 h, not REJECTED&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;scores the union instead of making a rival event&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1715" y="234" width="330" height="61" as="geometry" /></mxCell><mxCell id="sys-f_type" value='&lt;b style="font-size:12px"&gt;⑥ Type, witnesses, place&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;event_typing.py: published majority vote&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;corroboration.py: effective independent reporters&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;reverse geocode of the centroid → district&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1715" y="319" width="330" height="75" as="geometry" /></mxCell><mxCell id="sys-f_evid" value="&lt;b style=&quot;font-size:12px&quot;&gt;⑥ Weather evidence per hazard&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;evidence.py reads each hazard's own variable: rain, temperature, wind, visibility…&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;METAR within 50 km, else Open-Meteo; records affirmative contradictions&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1715" y="418" width="330" height="90" as="geometry" /></mxCell><mxCell id="sys-f_off" value='&lt;b style="font-size:12px"&gt;⑥ Official warning + news&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;official_warnings.py: SACHET polygon or named district&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;news: 2+ publishers 0.75, one publisher 0.55&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1715" y="532" width="330" height="61" as="geometry" /></mxCell><mxCell id="sys-f_receipt" value='&lt;b style="font-size:12px"&gt;⑥ Receipt v2 · fusion_engine.py&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;weather_station 0.20 · official_warning 0.10&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;report_density 0.20 · spatial_coherence 0.15&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;source_reliability 0.15&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;vision_analysis 0.15 · anomaly_detection 0.05: offline for good&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;confidence = Σ online w·s ÷ Σ online w, published with factor_coverage 0.80&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;deterministic: the same cluster gives the same receipt&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1715" y="617" width="330" height="134" as="geometry" /></mxCell><mxCell id="sys-f_route" value='&lt;b style="font-size:12px"&gt;⑥ Severity, verdict, routing&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;severity = max(content axis, count axis)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;verdict: CONTRADICTED › CORROBORATED (≥ 0.6) › UNCONFIRMED&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;≥ 0.90 and no cap → AUTO_PUBLISHED&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;≥ 0.60 → PENDING_HUMAN_REVIEW&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;below → QUARANTINED; HIGH/CRITICAL go to review&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1715" y="775" width="330" height="119" as="geometry" /></mxCell><mxCell id="sys-f_persist" value='&lt;b style="font-size:12px"&gt;⑦ Persist · one transaction&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;verified_events row, reports linked, boundary polygon, event_snapshots row, hash-chained audit row&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;row lock: a human decision is never overwritten&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1715" y="918" width="330" height="75" as="geometry" /></mxCell><mxCell id="sys-f_late" value='&lt;b style="font-size:12px"&gt;Late corroboration&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;late_corroboration.py: a new SACHET warning or a significant METAR re-scores open events&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;last 24 h, ≤ 50 per tick, each pair once (Redis)&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1715" y="1027" width="330" height="75" as="geometry" /></mxCell><mxCell id="sys-t_raw" value='&lt;b style="font-size:12px"&gt;raw_reports&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;every report and feed item: text, point, H3 cell, flags, analysis JSONB&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;← store_report · event_id, duplicate_of&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2115" y="280" width="290" height="75" as="geometry" /></mxCell><mxCell id="sys-t_out" value="&lt;b style=&quot;font-size:12px&quot;&gt;outbox&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;a report's Kafka message, same transaction · → outbox_relay&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2115" y="369" width="290" height="61" as="geometry" /></mxCell><mxCell id="sys-t_sr" value='&lt;b style="font-size:12px"&gt;station_readings&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Open-Meteo and METAR observations · ← station_poller, metar_poller&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2115" y="444" width="290" height="61" as="geometry" /></mxCell><mxCell id="sys-t_aa" value='&lt;b style="font-size:12px"&gt;agency_alerts&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;SACHET CAP warnings with area polygons · ← sachet_poller&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2115" y="519" width="290" height="61" as="geometry" /></mxCell><mxCell id="sys-t_ve" value='&lt;b style="font-size:12px"&gt;verified_events&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;type, severity, confidence, verdict, review_status, quadrant, centre, boundary polygon, receipt JSONB&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2115" y="594" width="290" height="61" as="geometry" /></mxCell><mxCell id="sys-t_snap" value='&lt;b style="font-size:12px"&gt;event_snapshots&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;one row per score write: confidence over time&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2115" y="669" width="290" height="46" as="geometry" /></mxCell><mxCell id="sys-t_audit" value='&lt;b style="font-size:12px"&gt;audit_logs&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;append-only SHA-256 chain; a trigger rejects UPDATE and DELETE&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2115" y="729" width="290" height="61" as="geometry" /></mxCell><mxCell id="sys-t_ops" value='&lt;b style="font-size:12px"&gt;teams · user_profiles&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;response units; operator accounts, roles, bcrypt password_hash&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2115" y="804" width="290" height="61" as="geometry" /></mxCell><mxCell id="sys-d_redis" value='&lt;b style="font-size:12px"&gt;Redis 7 · :6379&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Open-Meteo cache, broadcast-dedup set, failure counters, late-corroboration memory&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;every use has an in-memory fallback&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2105" y="892" width="310" height="75" as="geometry" /></mxCell><mxCell id="sys-d_s3" value='&lt;b style="font-size:12px"&gt;SeaweedFS · S3 API · 127.0.0.1:8333&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;indra-lake: raw/source=…/date=…/hour=… for reports, sachet, metar, mastodon, google_news&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;indra-media: reserved for report media&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2105" y="982" width="310" height="75" as="geometry" /></mxCell><mxCell id="sys-a_fast" value='&lt;b style="font-size:12px"&gt;FastAPI · uvicorn, one process&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;14 routers, CORS allow-list&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;hosts the consumer, relay, pollers and archiver as asyncio tasks&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;single process by design: WebSocket fan-out is in memory&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3E7F8;strokeColor=#3F51B5;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2475" y="234" width="310" height="90" as="geometry" /></mxCell><mxCell id="sys-a_auth" value='&lt;b style="font-size:12px"&gt;Auth + RBAC · core/security.py&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;POST /api/auth/token → HS256 JWT&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;bcrypt password_hash on user_profiles; no password in the code&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;/api/profile/me for the signed-in operator&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;every write is role-guarded (route-walking test)&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3E7F8;strokeColor=#3F51B5;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2475" y="338" width="310" height="105" as="geometry" /></mxCell><mxCell id="sys-a_read" value='&lt;b style="font-size:12px"&gt;Open reads&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;/api/dashboard/summary · /api/events, /distribution, /{id}&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;/api/reports/trend, /recent, /track/{docket}&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;/api/feed/recent · /api/geo/heatmap, /stations&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;/api/alerts/agency · /api/stations/latest&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;/api/meta/filters, /sources · /api/teams&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3E7F8;strokeColor=#3F51B5;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2475" y="457" width="310" height="105" as="geometry" /></mxCell><mxCell id="sys-a_analyst" value='&lt;b style="font-size:12px"&gt;ANALYST and above&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;/api/review/queue · /api/audit/recent&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;/api/events/{id}/provenance, /history&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;/api/events/export · /api/reports/search, /export (CSV, GeoJSON)&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3E7F8;strokeColor=#3F51B5;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2475" y="575" width="310" height="90" as="geometry" /></mxCell><mxCell id="sys-a_review" value='&lt;b style="font-size:12px"&gt;COMMANDER / ADMIN writes&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;POST, DELETE /api/events/{id}/claim → EVENT_CLAIMED&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;PATCH /api/events/{id}/review: approve, reject or re-grade, with a reason → EVENT_REVIEWED&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;POST /api/teams · PATCH /api/teams/{id}/assign&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3E7F8;strokeColor=#3F51B5;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2475" y="679" width="310" height="90" as="geometry" /></mxCell><mxCell id="sys-a_health" value='&lt;b style="font-size:12px"&gt;GET /healthz&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Postgres or Kafka down → 503&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Redis, Open-Meteo, object store, outbox backlog &amp;gt; 60 s → 200 degraded&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3E7F8;strokeColor=#3F51B5;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2475" y="783" width="310" height="75" as="geometry" /></mxCell><mxCell id="sys-a_ws" value='&lt;b style="font-size:12px"&gt;WebSocket /ws/events&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;NEW_REPORT · NEW_FEED_ITEM · VERIFIED_EVENT · EVENT_CLAIMED · EVENT_REVIEWED&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3E7F8;strokeColor=#3F51B5;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2475" y="873" width="310" height="61" as="geometry" /></mxCell><mxCell id="sys-c_ops" value='&lt;b style="font-size:12px"&gt;Commanders and analysts&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;sign in; claim, approve or reject with a reason&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2845" y="234" width="300" height="46" as="geometry" /></mxCell><mxCell id="sys-c_cc" value="&lt;b style=&quot;font-size:12px&quot;&gt;9 · IMD Command Center&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Next.js 14 dashboard · the frontend team's layer&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;MapLibre map, WebGL globe, Recharts&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;pages: / · live-map · events · reports · alerts · analytics · admin · teams · profile · datasets · settings&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Report Incident form, sign-in, verification receipt, review&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;API base URL baked in at build time&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2845" y="338" width="300" height="562" as="geometry" /></mxCell><mxCell id="sys-c_alert" value='&lt;b style="font-size:12px"&gt;8b · Alert engine · not run on the team server&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;alert_engine/: a separate FastAPI on :8001, owned by the alert-engine teammate&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;listens on /ws/events, falls back to polling /api/events&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;rules, lifecycle, dedup · SMTP e-mail · /api/alerts, /ws/alerts&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="2845" y="944" width="300" height="105" as="geometry" /></mxCell><mxCell id="sys-banner" value='&lt;span style="font-size:12px"&gt;&lt;b style="font-size:13px"&gt;pipeline.process_report()&lt;/b&gt; — one call per message on indra.raw.reports: ② dedup → ③–⑤ cluster → ⑤a merge → ⑥ score → ⑦ persist. Fail-soft: one bad report never stops the consumer.&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1030" y="104" width="1030" height="58" as="geometry" /></mxCell><mxCell id="sys-scripts" value='&lt;b style="font-size:12px"&gt;scripts/ and data/ · operations&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;rescore_events.py: gives every stored event a v2 receipt and a verdict&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;run_verification_demo.py: a genuine and a fabricated case on live weather, writing nothing&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;replay_dlq.py: re-publishes dead letters · set_operator_password.py: a bcrypt hash per account&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;export_live_data.py → data/live (CSV, GeoJSON) · build_gazetteer.py, build_metar_stations.py → data/geo&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;make_s3_config.py → infra/seaweedfs/s3.json (gitignored)&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="20" y="1245" width="700" height="105" as="geometry" /></mxCell><mxCell id="sys-hosting" value='&lt;b style="font-size:12px"&gt;Where it runs (page 3)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;AWS EC2 t3.xlarge, ap-south-1, Kali Linux, code at /opt/indra&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Caddy HTTPS at indra-sixthsense.duckdns.org: /api, /ws, /healthz, /docs → :8000; the rest → :3000&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;systemd: indra-api (uvicorn), indra-frontend (next start)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;docker compose: PostGIS, Redis, Redpanda, SeaweedFS&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;stopped when nobody is working; a Lightsail move is planned, not done&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F5F0;strokeColor=#56606B;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="750" y="1245" width="700" height="105" as="geometry" /></mxCell><mxCell id="sys-lg0" value='&lt;b style="font-size:12px"&gt;1 · Data sources&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1496" y="1279" width="196" height="34" as="geometry" /></mxCell><mxCell id="sys-lg1" value='&lt;b style="font-size:12px"&gt;2 · Ingestion&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1702" y="1279" width="196" height="34" as="geometry" /></mxCell><mxCell id="sys-lg2" value='&lt;b style="font-size:12px"&gt;3 · Processing&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1908" y="1279" width="196" height="34" as="geometry" /></mxCell><mxCell id="sys-lg3" value='&lt;b style="font-size:12px"&gt;4 · AI/ML, frozen&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2114" y="1279" width="196" height="34" as="geometry" /></mxCell><mxCell id="sys-lg4" value='&lt;b style="font-size:12px"&gt;5 · Geo-analytics&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D3EEEC;strokeColor=#2A8C82;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1496" y="1321" width="196" height="34" as="geometry" /></mxCell><mxCell id="sys-lg5" value='&lt;b style="font-size:12px"&gt;6 · Event fusion&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1702" y="1321" width="196" height="34" as="geometry" /></mxCell><mxCell id="sys-lg6" value='&lt;b style="font-size:12px"&gt;7 · Data platform&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1908" y="1321" width="196" height="34" as="geometry" /></mxCell><mxCell id="sys-lg7" value='&lt;b style="font-size:12px"&gt;8a · Real-time API&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3E7F8;strokeColor=#3F51B5;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2114" y="1321" width="196" height="34" as="geometry" /></mxCell><mxCell id="sys-lg_o" value="&lt;b style=&quot;font-size:12px&quot;&gt;8b, 9 · other team members' layers&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="2320" y="1279" width="330" height="34" as="geometry" /></mxCell><mxCell id="sys-lg_d" value='&lt;b style="font-size:12px"&gt;dashed: offline, off, not built or not run&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="2320" y="1321" width="330" height="34" as="geometry" /></mxCell><mxCell id="sys-lg_t" value="Solid arrow: data flow · dashed arrow: a read, an advisory result or an optional service · ②–⑦: the steps of pipeline.process_report(), as numbered in services/pipeline.py.&lt;br&gt;Aditya owns layers 1, 2, 3, 5, 6, 7 and 8a. Layer 4 (AI/ML), 8b (alert engine) and 9 (
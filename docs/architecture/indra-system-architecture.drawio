orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.0931;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys-c_cc" target="sys-a_auth"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sys-e37" value="claim, review" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.6872;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys-c_cc" target="sys-a_review"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sys-e38" value="JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3041;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys-a_read" target="sys-c_cc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sys-e39" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.2632;exitDx=0;exitDy=0;entryX=0;entryY=0.9798;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys-a_ws" target="sys-c_cc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sys-e40" value="listens" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#B85450;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=5 4;exitX=1;exitY=0.8026;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys-a_ws" target="sys-c_alert"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2815" y="921" /><mxPoint x="2815" y="996" /></Array></mxGeometry></mxCell><mxCell id="sys-e41" value="alerts page" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#B85450;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=5 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys-c_alert" target="sys-c_cc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sys-e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys-c_ops" target="sys-c_cc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sys-e43" value="raw copies (bronze)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys-i_lake" target="sys-d_s3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="822" y="1159" /><mxPoint x="2260" y="1159" /></Array></mxGeometry></mxCell><mxCell id="sys-e44" value="SACHET / METAR triggers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys-i_poll" target="sys-f_late"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="508" y="1181" /><mxPoint x="1880" y="1181" /></Array></mxGeometry></mxCell><mxCell id="sys-e45" value="VERIFIED_EVENT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.8408;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys-f_persist" target="sys-a_ws"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2081" y="981" /><mxPoint x="2081" y="1203" /><mxPoint x="2441" y="1203" /><mxPoint x="2441" y="903" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="life" name="2 · Report lifecycle"><mxGraphModel background="#FFFFFF" dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1940" pageHeight="2505" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="life-lane_r" value="&lt;b&gt;Human review · Phase 4 T7&lt;/b&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#F5F6FD;strokeColor=#3F51B5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#222222;strokeWidth=1.5;container=0;" vertex="1" parent="1"><mxGeometry x="1520" y="1952" width="390" height="513" as="geometry" /></mxCell><mxCell id="life-lane_l" value="&lt;b&gt;Late corroboration · Phase 4 T5&lt;/b&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#222222;strokeWidth=1.5;container=0;" vertex="1" parent="1"><mxGeometry x="30" y="1328" width="380" height="437" as="geometry" /></mxCell><mxCell id="life-title" value='&lt;b style="font-size:24px"&gt;One report, from arrival to a decided event&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;api/reports.py → services/ingest.py → Redpanda → workers/report_consumer.py → services/pipeline.py::process_report(). Colours as on page 1. Left: late corroboration re-scores open events. Right: the human review that decides what the machine routed to a person.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#222222;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="18" width="1880" height="70" as="geometry" /></mxCell><mxCell id="life-n_start" value="&lt;b style=&quot;font-size:12px&quot;&gt;A report arrives&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;the dashboard's form (citizen) · an official report (JWT) · a Mastodon post · a news headline&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontColor=#1A1A1A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="770" y="110" width="340" height="61" as="geometry" /></mxCell><mxCell id="life-d_india" value='&lt;b style="font-size:12px"&gt;Inside India?&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;API routes; feed items are placed from their text&lt;/span&gt;' style="rhombus;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=center;verticalAlign=middle;spacing=14;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="805" y="211" width="270" height="112" as="geometry" /></mxCell><mxCell id="life-t_422" value='&lt;b style="font-size:12px"&gt;422 · rejected&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;never stored, never published&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1190" y="244" width="280" height="46" as="geometry" /></mxCell><mxCell id="life-n_store" value='&lt;b style="font-size:12px"&gt;ingest.store_report()&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;cleaned text, language, depth, keywords, places · hazard tags · flags · credibility&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;raw_reports row + outbox row, one transaction&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="740" y="363" width="400" height="75" as="geometry" /></mxCell><mxCell id="life-d_stored" value='&lt;b style="font-size:12px"&gt;Stored?&lt;/b&gt;' style="rhombus;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=center;verticalAlign=middle;spacing=14;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="805" y="478" width="270" height="112" as="geometry" /></mxCell><mxCell id="life-t_503" value='&lt;b style="font-size:12px"&gt;503 · not stored&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;nothing stored, nothing published; the caller can retry&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1190" y="504" width="280" height="61" as="geometry" /></mxCell><mxCell id="life-n_pub" value='&lt;b style="font-size:12px"&gt;Publish to indra.raw.reports&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;at once, within 2 s → 202 + docket R-XXXXXXXX&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Kafka down → 202 queued: false, and outbox_relay publishes it later&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="740" y="630" width="400" height="61" as="geometry" /></mxCell><mxCell id="life-n_cons" value='&lt;b style="font-size:12px"&gt;report_consumer&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;NEW_REPORT (or NEW_FEED_ITEM for a post or headline) on /ws/events, once per report id&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="740" y="731" width="400" height="61" as="geometry" /></mxCell><mxCell id="life-n_load" value='&lt;b style="font-size:12px"&gt;① Load the stored row&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;the message is only a trigger: every decision uses the row in Postgres&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="740" y="832" width="400" height="46" as="geometry" /></mxCell><mxCell id="life-d_dup" value='&lt;b style="font-size:12px"&gt;② Duplicate?&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;frozen matcher · ≤ 1 km · ≤ 15 min&lt;/span&gt;' style="rhombus;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;verticalAlign=middle;spacing=14;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="805" y="918" width="270" height="112" as="geometry" /></mxCell><mxCell id="life-t_dup" value='&lt;b style="font-size:12px"&gt;Suppressed&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;duplicate_of = the original&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;never counts as corroboration; no event&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1190" y="944" width="280" height="61" as="geometry" /></mxCell><mxCell id="life-n_coord" value="&lt;b style=&quot;font-size:12px&quot;&gt;②b Coordinated text?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;the same text from ≥ 3 reporters within 10 min: each copy's credibility halved&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="740" y="1070" width="400" height="46" as="geometry" /></mxCell><mxCell id="life-n_prep" value='&lt;b style="font-size:12px"&gt;③ Spatial preparation&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;geom_point and an H3 res-8 cell&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D3EEEC;strokeColor=#2A8C82;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="740" y="1156" width="400" height="46" as="geometry" /></mxCell><mxCell id="life-d_clu" value='&lt;b style="font-size:12px"&gt;④ In a DBSCAN cluster?&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;5 km · ≥ 2 reports · same hazard family&lt;/span&gt;' style="rhombus;whiteSpace=wrap;html=1;fillColor=#D3EEEC;strokeColor=#2A8C82;fontSize=12;align=center;verticalAlign=middle;spacing=14;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="805" y="1242" width="270" height="112" as="geometry" /></mxCell><mxCell id="life-d_foot" value="&lt;b style=&quot;font-size:12px&quot;&gt;Inside a known event's footprint?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#D3EEEC;strokeColor=#2A8C82;fontSize=12;align=center;verticalAlign=middle;spacing=14;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1205" y="1243" width="250" height="110" as="geometry" /></mxCell><mxCell id="life-t_lone" value='&lt;b style="font-size:12px"&gt;Lone report · no event yet&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;a single report is not an event; it waits for a neighbour&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1190" y="1389" width="280" height="61" as="geometry" /></mxCell><mxCell id="life-n_geom" value='&lt;b style="font-size:12px"&gt;⑤ Cluster geometry&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;centroid, impact radius, max pairwise distance&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D3EEEC;strokeColor=#2A8C82;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="740" y="1394" width="400" height="46" as="geometry" /></mxCell><mxCell id="life-d_merge" value='&lt;b style="font-size:12px"&gt;⑤a Overlaps a recent event?&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;radius + eps · last 2 h · not REJECTED&lt;/span&gt;' style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;align=center;verticalAlign=middle;spacing=14;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="805" y="1481" width="270" height="112" as="geometry" /></mxCell><mxCell id="life-t_merge" value='&lt;b style="font-size:12px"&gt;Merge into it&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;score the union of both report sets, not a rival event&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1190" y="1514" width="280" height="46" as="geometry" /></mxCell><mxCell id="life-n_score" value="&lt;b style=&quot;font-size:12px&quot;&gt;⑥ Score&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;type: majority vote of the reports (event_typing.py); a commander's type stands&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;witnesses: effective independent reporters (corroboration.py)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;place: reverse geocode of the centroid → district&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;weather: this hazard's own variable from a METAR within 50 km, else Open-Meteo, over the observed span ± 3 h (rain and flood: 24 h)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;official warning: a SACHET polygon or the named district&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;news: 2+ publishers 0.75 · one 0.55&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;receipt v2: 7 weighted factors; vision and anomaly are offline for good, so factor_coverage is 0.80&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;severity = max(content axis: depth and hazard rules, count axis)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="740" y="1649" width="400" height="192" as="geometry" /></mxCell><mxCell id="life-n_verdict" value='&lt;b style="font-size:12px"&gt;Verdict&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;CONTRADICTED: the weather says the opposite; a human decides&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;CORROBORATED: official warning or weather evidence ≥ 0.6&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;UNCONFIRMED: nothing independent either way&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="740" y="1881" width="400" height="75" as="geometry" /></mxCell><mxCell id="life-n_route" value='&lt;b style="font-size:12px"&gt;Review status and quadrant&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;≥ 0.90 and no cap → AUTO_PUBLISHED&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;≥ 0.60 → PENDING_HUMAN_REVIEW&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;&amp;lt; 0.60 → QUARANTINED, but HIGH/CRITICAL → PENDING_HUMAN_REVIEW&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;caps, never auto-published: contradicted · unclassified · posts only&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;quadrant: HIGH/CRITICAL ≥ 0.90 Critical Verified, else Unverified Threat; ADVISORY/MODERATE ≥ 0.60 Confirmed Minor, else Noise&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="740" y="1996" width="400" height="134" as="geometry" /></mxCell><mxCell id="life-n_persist" value='&lt;b style="font-size:12px"&gt;⑦ Persist · one transaction&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;lock the event row; keep any human decision (status, severity, type)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;verified_events · reports linked · boundary polygon · event_snapshots row&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;audit row on create or status change: AUTO_VERIFY · ESCALATE · QUARANTINE&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="740" y="2170" width="400" height="90" as="geometry" /></mxCell><mxCell id="life-n_out" value='&lt;b style="font-size:12px"&gt;Out&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;VERIFIED_EVENT on /ws/events · the event on indra.verified.events&lt;/span&gt;' style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E3E7F8;strokeColor=#3F51B5;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;fontColor=#1A1A1A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="770" y="2300" width="340" height="61" as="geometry" /></mxCell><mxCell id="life-s_dlq" value='&lt;b style="font-size:12px"&gt;On a pipeline failure&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;retried; the count lives in Redis&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;then → indra.raw.reports.dlq&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;scripts/replay_dlq.py re-publishes it&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="440" y="724" width="260" height="75" as="geometry" /></mxCell><mxCell id="life-s_ml" value='&lt;b style="font-size:12px"&gt;Advisory ML analysis · layer 4&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;six frozen components → raw_reports.analysis.ml&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;for every report, even a lone one or a duplicate&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;never a fusion factor, never decides review status&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="440" y="922" width="260" height="105" as="geometry" /></mxCell><mxCell id="life-l_sachet" value='&lt;b style="font-size:12px"&gt;sachet_poller · every 5 min&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;a new, updated or cancelled warning&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="45" y="1372" width="350" height="46" as="geometry" /></mxCell><mxCell id="life-l_metar" value='&lt;b style="font-size:12px"&gt;metar_poller · every 10 min&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;TS, FG, DS, GR…, visibility &amp;lt; 1 km, gusts ≥ 39 km/h, ≥ 40 °C or ≤ 10 °C&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="45" y="1448" width="350" height="61" as="geometry" /></mxCell><mxCell id="life-l_find" value='&lt;b style="font-size:12px"&gt;Find open events&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;updated in the last 24 h, not REJECTED, a hazard family the trigger speaks to&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;footprint ∩ warning polygon, the named district, or within 50 km of the station&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="45" y="1539" width="350" height="90" as="geometry" /></mxCell><mxCell id="life-l_rescore" value='&lt;b style="font-size:12px"&gt;rescore_event()&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;≤ 50 events per trigger per tick; the rest wait for the next tick&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;each (trigger, event) once, remembered 24 h in Redis&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;a change writes a snapshot and a LATE_CORROBORATION audit row; no change writes nothing&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="45" y="1659" width="350" height="90" as="geometry" /></mxCell><mxCell id="life-r_queue" value='&lt;b style="font-size:12px"&gt;Review queue&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;GET /api/review/queue · ANALYST and above&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;PENDING_HUMAN_REVIEW and QUARANTINED events, in tabs&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3E7F8;strokeColor=#3F51B5;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1535" y="1996" width="360" height="61" as="geometry" /></mxCell><mxCell id="life-r_claim" value='&lt;b style="font-size:12px"&gt;Claim&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;POST /api/events/{id}/claim · COMMANDER/ADMIN → EVENT_CLAIMED; DELETE releases it&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3E7F8;strokeColor=#3F51B5;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1535" y="2087" width="360" height="61" as="geometry" /></mxCell><mxCell id="life-r_decide" value='&lt;b style="font-size:12px"&gt;Decide, with a reason&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;PATCH /api/events/{id}/review: approve, reject, or re-grade severity or type&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;an illegal transition → 409; two approvals at once → one 200, one 409&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3E7F8;strokeColor=#3F51B5;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1535" y="2178" width="360" height="75" as="geometry" /></mxCell><mxCell id="life-r_rec" value='&lt;b style="font-size:12px"&gt;Recorded&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;HUMAN_APPROVED or REJECTED&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;audit row HUMAN_APPROVE · HUMAN_REJECT · MANUAL_OVERRIDE&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;EVENT_REVIEWED on /ws/events&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3E7F8;strokeColor=#3F51B5;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1535" y="2283" width="360" height="90" as="geometry" /></mxCell><mxCell id="life-r_note" value='&lt;span style="font-size:11px"&gt;Later reports still re-score the event: its confidence moves, the human decision does not.&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1535" y="2403" width="360" height="46" as="geometry" /></mxCell><mxCell id
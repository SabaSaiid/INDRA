:16-3.4&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;host 5433 → 5432 · volume postgres_data&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;healthy = pg_isready over TCP&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1525" y="220" width="325" height="75" as="geometry" /></mxCell><mxCell id="dep-dk_redis" value='&lt;b style="font-size:12px"&gt;indra-redis&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;redis:7-alpine · 6379 · volume redis_data&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1525" y="317" width="325" height="46" as="geometry" /></mxCell><mxCell id="dep-dk_rp" value='&lt;b style="font-size:12px"&gt;indra-redpanda&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;redpanda v23.3.11 · 1 core, --memory 512M&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Kafka 19092 (host), 9092 (inside) · admin 9644&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;volume redpanda_data&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1525" y="386" width="325" height="75" as="geometry" /></mxCell><mxCell id="dep-dk_s3" value='&lt;b style="font-size:12px"&gt;indra-objectstore&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;chrislusf/seaweedfs:4.47&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;S3 on 127.0.0.1:8333 only · volume objectstore_data&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:1
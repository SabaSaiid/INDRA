ign=left;spacingLeft=12;spacingTop=4;fontSize=13;fontColor=#222222;strokeWidth=1.5;container=0;" vertex="1" parent="1"><mxGeometry x="1510" y="174" width="355" height="406" as="geometry" /></mxCell><mxCell id="dep-title" value='&lt;b style="font-size:24px"&gt;Where INDRA runs&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;The team server as of 27 Sep 2026 (aditya/server.md). One HTTPS name for the dashboard, the API and the WebSocket. Ports that are not listed as open are closed.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#222222;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="18" width="2200" height="70" as="geometry" /></mxCell><mxCell id="dep-u_cit" value="&lt;b style=&quot;font-size:12px&quot;&gt;Citizens&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;a browser: the dashboard's Report Incident form&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="35" y="154" width="270" height="46" as="geometry" /></mxCell><mxCell id="dep-u_ops" value='&lt;b style="font-size:12px"&gt;Commanders, analysts, admins&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;a browser: the command center, signed in for review and writes&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="35" y="240" width="270" height="61" as="geometry" /></mxCell><mxCell id="dep-u_dev" value="&lt;b style=&quot;font-size:12px&quot;&gt;Aditya's Mac&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ssh indra: key-based login from his home IP&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;builds main first, then deploys: git pull, alembic upgrade head, systemctl restart&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="35" y="401" width="270" height="75" as="geometry" /></mxCell><mxCell id="dep-u_gh" value='&lt;b style="font-size:12px"&gt;GitHub · SabaSaiid/INDRA&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;main plus dated feature branches, merged by pull request&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="35" y="516" width="270" height="61" as="geometry" /></mxCell><mxCell id="dep-n_dns" value='&lt;b style="font-size:12px"&gt;DuckDNS&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;indra-sixthsense.duckdns.org → Elastic IP 15.252.50.176&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="375" y="154" width="270" height="61" as="geometry" /></mxCell><mxCell id="dep-n_sg" value="&lt;b style=&quot;font-size:12px&quot;&gt;Security group&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;22 ← Aditya's home IP only&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;80, 443 ← anywhere: Caddy&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;3000, 8000 ← anywhere as of 24 Sep; to close once the team uses HTTPS&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;5433, 6379, 19092, 8333: never opened&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="375" y="265" width="270" height="105" as="geometry" /></mxCell><mxCell id="dep-h_caddy" value="&lt;b style=&quot;font-size:12px&quot;&gt;Caddy 2 · caddy.service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;:80 redirects, :443 serves HTTPS&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Let's Encrypt certificate, renewed by Caddy&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;/api/* · /ws/* · /healthz · /docs → localhost:8000&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;everything else → localhost:3000&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3E7F8;strokeColor=#3F51B5;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="715" y="174" width="290" height="90" as="geometry" /></mxCell><mxCell id="dep-h_fe" value="&lt;b style=&quot;font-size:12px&quot;&gt;indra-frontend.service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;next start -H 0.0.0.0 -p 3000, NODE_ENV=production&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;API base https://indra-sixthsense.duckdns.org, baked into the build (NEXT_PUBLIC_API_BASE_URL)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;code: the frontend team's (layer 9)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="715" y="324" width="290" height="90" as="geometry" /></mxCell><mxCell id="dep-h_ae" value="&lt;b style=&quot;font-size:12px&quot;&gt;alert_engine · :8001&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;not running here; the dashboard's alert URLs point at the API until it does&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="715" y="438" width="290" height="61" as="geometry" /></mxCell><mxCell id="dep-api_http" value='&lt;b style="font-size:12px"&gt;HTTP + WebSocket&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;14 routers · /ws/events · /healthz · /docs&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3E7F8;strokeColor=#3F51B5;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1045" y="220" width="420" height="46" as="geometry" /></mxCell><mxCell id="dep-t_hdr" value="&lt;b&gt;asyncio tasks, started by the lifespan hook&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;spacing=0;" vertex="1" parent="1"><mxGeometry x="1045" y="280" width="420" height="20" as="geometry" /></mxCell><mxCell id="dep-t_cons" value='&lt;b style="font-size:12px"&gt;report_consumer&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1045" y="304" width="205" height="32" as="geometry" /></mxCell><mxCell id="dep-t_relay" value='&lt;b style="font-size:12px"&gt;outbox_relay&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1260" y="304" width="205" height="32" as="geometry" /></mxCell><mxCell id="dep-t_lake" value='&lt;b style="font-size:12px"&gt;lake_archiver&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1045" y="344" width="205" height="32" as="geometry" /></mxCell><mxCell id="dep-t_warm" value='&lt;b style="font-size:12px"&gt;duplicate-matcher warm-up&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1260" y="344" width="205" height="32" as="geometry" /></mxCell><mxCell id="dep-t_sachet" value='&lt;b style="font-size:12px"&gt;sachet_poller · 5 min&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1045" y="384" width="205" height="32" as="geometry" /></mxCell><mxCell id="dep-t_station" value='&lt;b style="font-size:12px"&gt;station_poller · 10 min&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="1260" y="384" width="205" height="32" as="geometry" /></mxCell><mxCell id="dep-t_metar" value='&lt;b style="font-size:12px"&gt;metar_poller · 10 min&lt;/b&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12
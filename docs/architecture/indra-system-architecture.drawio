eft;spacingLeft=8;spacingRight=8;spacingTop=5;spacingBottom=5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="30" y="652" width="1930" height="90" as="geometry" /></mxCell><mxCell id="data-e1" value="event_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.8231;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="data-raw_reports" target="data-verified_events"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="308" /><mxPoint x="480" y="215" /></Array></mxGeometry></mxCell><mxCell id="data-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.8855;exitDx=0;exitDy=0;entryX=0;entryY=0.9584;entryDx=0;entryDy=0;" edge="1" parent="1" source="data-raw_reports" target="data-raw_reports"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="14" y="320" /><mxPoint x="14" y="334" /></Array></mxGeometry></mxCell><mxCell id="data-e3" value="same transaction" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#555555;strokeWidth=1.5;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=5 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="data-outbox" target="data-raw_reports"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="data-e4" value="event_id · CASCADE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=b